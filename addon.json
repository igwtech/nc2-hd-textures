{
  "name": "HD Textures",
  "id": "nc2-hd-textures",
  "version": "0.2.0",
  "author": "Neocron Community",
  "description": "AI-upscaled textures using Real-ESRGAN 4x. Replaces all game textures with high-resolution versions while preserving the original art style. v0.2 also ships an AI-generated normal-map corpus (~2900 _n.png files derived from the HD albedos via DeepBump v8) and a hash-keyed texture index, both consumed by the neocron-renodx-engine addon for per-texture normal-mapped lighting.",
  "category": "graphics",
  "tags": ["textures", "hd", "4k", "esrgan", "upscale", "graphics", "normal-maps", "deepbump"],
  "files": [
    { "src": "gfx/decals/",        "dst": "gfx/decals/" },
    { "src": "gfx/modeltextures/", "dst": "gfx/modeltextures/" },
    { "src": "gfx/items/",         "dst": "gfx/items/" },
    { "src": "gfx/maps/",          "dst": "gfx/maps/" },
    { "src": "gfx/misc/",          "dst": "gfx/misc/" },
    { "src": "gfx/rpos/",          "dst": "gfx/rpos/" },
    { "src": "gfx/rposv3/",        "dst": "gfx/rposv3/" },
    { "src": "gfx/sky/",           "dst": "gfx/sky/" },
    { "src": "gfx/eventtextures/", "dst": "gfx/eventtextures/" },
    { "src": "gfx/mainmenu/",      "dst": "gfx/mainmenu/" },
    { "src": "gfx/weapon_fx/",     "dst": "gfx/weapon_fx/" },
    { "src": "gfx/worlds/",        "dst": "gfx/worlds/" },
    { "src": "texture_index.txt",  "dst": "neocron_texture_index.txt" }
  ],
  "fetch": [
    {
      "from": "https://github.com/igwtech/nc2-hd-textures/releases/download/v0.2.0/nc2-normals-corpus.tar.gz",
      "extract": "tar.gz",
      "files": [
        { "src": "*",  "dst": "gfx_normals/" }
      ]
    }
  ],
  "conflicts": [],
  "requires": []
}
